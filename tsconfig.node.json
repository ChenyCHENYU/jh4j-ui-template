{
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["vite.config.ts", "vite/**/*.ts"]
}
