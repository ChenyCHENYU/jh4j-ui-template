# 非敏感的跨环境默认值。本机或部署环境请通过 .env.local / 环境变量覆盖。
# 各环境服务地址不在本文件维护，统一保存在 project.config.json 的 environments。

# AnyReport 打印报表服务器地址（未接入报表可留空）
ENV_ANY_REPORT_SERVER=
ENV_ANY_REPORT_SECRET_KEY=

# token 存储介质：true = localStorage，留空 = Cookie。
# 注意：运行时在 router 初始化前读取该值（见 src/main-core.ts），
# 修改后需重启 dev server 生效。
TOKEN_LOCALSTORAGE=true
