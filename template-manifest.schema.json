{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jh4j:schema:template-manifest:1",
  "title": "JH4J Template Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "category", "runtime", "defaults", "parameters"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([+-].+)?$" },
    "category": { "enum": ["frontend", "backend", "mobile"] },
    "runtime": { "type": "object" },
    "defaults": { "type": "object" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "defaultEnabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "defaultEnabled": { "type": "boolean" },
          "required": { "type": "boolean" },
          "package": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "parameters": { "type": "array" },
    "entry": { "type": "object" },
    "generatedMetadata": { "type": "string" }
  },
  "additionalProperties": true
}
