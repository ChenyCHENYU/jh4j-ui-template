{
  "name": "jh4j-ui-template",
  "version": "1.4.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ChenyCHENYU/jh4j-ui-template.git"
  },
  "homepage": "https://github.com/ChenyCHENYU/jh4j-ui-template#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11.8.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "setup": "node scripts/setup-project.mjs",
    "template:validate": "node scripts/validate-template.mjs",
    "dev": "vite --open --mode dev --",
    "dev:local": "vite --open --mode dev -- --backend=local",
    "dev:public": "vite --open --mode dev -- --public=local",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build --mode dev",
    "build:dev": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build --mode dev",
    "build:sit": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build --mode sit",
    "build:uat": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build --mode uat",
    "build:pre": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build --mode pre",
    "build:prd": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite build --mode prd",
    "postinstall": "node scripts/patch-common-core-dts.mjs",
    "prepare": "husky",
    "cz": "git-cz",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@agile-team/wl-skills-ui": "^1.13.0",
    "@jhlc/common-core": "3.1.0-prod.14",
    "@jhlc/types": "3.1.0",
    "@element-plus/icons-vue": "2.1.0",
    "@vueuse/core": "8.9.4",
    "axios": "0.33.0",
    "element-plus": "2.2.6-prod.3",
    "jquery": "^3.7.1",
    "json-bigint": "^1.0.0",
    "lodash-es": "^4.17.21",
    "pinia": "~2.0.14",
    "pinia-plugin-persistedstate": "3.1.0",
    "reflect-metadata": "^0.2.2",
    "vue": "3.5.40",
    "vue-i18n": "9.13.1",
    "vue-router": "4.4.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@originjs/vite-plugin-federation": "1.4.1",
    "@robot-admin/git-standards": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "opencc-js": "^1.0.5",
    "postcss-preset-env": "^10.1.3",
    "prettier": "^3.3.0",
    "sass": "1.77.4",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "20.3.0",
    "unplugin-vue-components": "29.2.0",
    "vite": "7.3.6",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.0.0",
    "@vue/compiler-sfc": "3.5.40"
  },
  "overrides": {
    "@swc/core": "1.6.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  }
}
